# Managed by Ansible - roles/k3s_server/templates/config.yaml.j2
# Edits here are overwritten on the next run. Change the role instead.
{% if k3s_server_is_first | bool %}
# Without cluster-init k3s silently uses sqlite instead of etcd. The
# cluster starts and looks healthy, but no second server can ever join and
# there is no supported way to convert afterwards - see ADR 0001.
cluster-init: true
{% else %}
server: "{{ k3s_server_join_url }}"
{% endif %}
token: "{{ k3s_server_token }}"

node-name: "{{ k3s_server_node_name }}"
node-ip: "{{ k3s_server_node_ip }}"
advertise-address: "{{ k3s_server_node_ip }}"
flannel-iface: "{{ k3s_server_flannel_iface }}"

# No bind-address is set. The API server has to keep listening on
# 127.0.0.1 or this node's own /etc/rancher/k3s/k3s.yaml, which points at
# localhost, stops working. What keeps 6443 off the internet is the host
# firewall, not the bind address - see roles/base/tasks/oracle_firewall.yml.

tls-san:
  - "{{ k3s_server_node_ip }}"
  - "{{ ansible_hostname }}.{{ tailnet }}"
{% for san in k3s_server_extra_tls_sans %}
  - "{{ san }}"
{% endfor %}

# Applied when the node first registers. tasks/labels.yml reconciles it on
# every run, which is what makes changing node_role later actually work.
node-label:
  - "{{ k3s_server_node_label }}"
{% if k3s_server_secrets_encryption | bool %}

secrets-encryption: true
{% endif %}
{% if k3s_server_disable %}

disable:
{% for component in k3s_server_disable %}
  - "{{ component }}"
{% endfor %}
{% endif %}
