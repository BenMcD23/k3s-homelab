# Managed by Ansible - roles/k3s_server/templates/config.yaml.j2
# Edits here are overwritten on the next run. Change the role instead.
{% if k3s_server_is_first | bool %}
# Without cluster-init k3s uses sqlite instead of etcd. The cluster comes
# up and looks healthy, but no second server can join and there is no
# supported way to convert afterwards (ADR 0001).
cluster-init: true
{% else %}
server: "{{ k3s_server_join_url }}"
{% endif %}
token: "{{ k3s_server_token }}"

node-name: "{{ k3s_server_node_name }}"
node-ip: "{{ k3s_server_node_ip }}"
advertise-address: "{{ k3s_server_node_ip }}"
flannel-iface: "{{ k3s_server_flannel_iface }}"

# bind-address is left unset so the API server keeps listening on 127.0.0.1;
# the node's own /etc/rancher/k3s/k3s.yaml points there. 6443 is kept off the
# internet by the host firewall, see roles/base/tasks/oracle_firewall.yml.

tls-san:
  - "{{ k3s_server_node_ip }}"
  - "{{ ansible_hostname }}.{{ tailnet }}"
{% for san in k3s_server_extra_tls_sans %}
  - "{{ san }}"
{% endfor %}

# Only applied when the node first registers; tasks/labels.yml reapplies it
# on every run so node_role changes take effect.
node-label:
  - "{{ k3s_server_node_label }}"
{% if k3s_server_secrets_encryption | bool %}

secrets-encryption: true
{% endif %}
{% if k3s_server_disable %}

disable:
{% for component in k3s_server_disable %}
  - "{{ component }}"
{% endfor %}
{% endif %}
