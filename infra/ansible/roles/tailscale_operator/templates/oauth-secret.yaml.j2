# Managed by Ansible - roles/tailscale_operator/templates/oauth-secret.yaml.j2
# Edits here are overwritten on the next run. Change the role instead.
#
# The operator mounts this as a volume and exchanges it for tailnet auth
# keys. It is a bootstrap infrastructure secret in the same class as the
# Tailscale auth key and the k3s token - needed before GitOps can publish
# anything - so it comes from SOPS via Ansible rather than from whatever
# answers the in-cluster secrets question in ADR 0002.
apiVersion: v1
kind: Secret
metadata:
  name: operator-oauth
  namespace: {{ tailscale_operator_namespace }}
type: Opaque
stringData:
  client_id: "{{ tailscale_operator_oauth_client_id }}"
  client_secret: "{{ tailscale_operator_oauth_client_secret }}"
