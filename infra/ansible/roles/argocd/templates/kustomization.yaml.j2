# Managed by Ansible - roles/argocd/templates/kustomization.yaml.j2
# Edits here are overwritten on the next run. Change the role instead.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: {{ argocd_namespace }}

resources:
  - namespace.yaml
  - install.yaml

patches:
  # ADR 0004: Argo CD is used by a person directly, so it is pinned to the
  # interactive node instead of being spread by available capacity. Left to
  # the scheduler it lands wherever there is room - including squadron,
  # whose link is the one that goes away.
  #
  # Targeting by kind rather than by name so a component added in a later
  # Argo CD release is pinned too, instead of quietly landing elsewhere.
  - target:
      kind: Deployment
    patch: |-
      - op: add
        path: /spec/template/spec/nodeSelector
        value:
          role: {{ argocd_node_role }}
  - target:
      kind: StatefulSet
    patch: |-
      - op: add
        path: /spec/template/spec/nodeSelector
        value:
          role: {{ argocd_node_role }}
{% if argocd_expose != 'cluster' %}

  # tailscaled runs on the host, outside the cluster network, and will only
  # proxy to a localhost target - so the UI needs a fixed port on the node
  # for it to reach. The ports are pinned rather than allocated at random so
  # the serve config written in tasks/expose.yml stays correct across
  # reinstalls.
  #
  # NodePorts bind every interface on every node, not just this one. What
  # keeps that from being an open door is the host firewall (oracle) and the
  # fact that argocd-server still wants a login either way; see ADR 0005.
  #
  # Each port is spelled out in full. A strategic merge patch that names
  # only the port and the nodePort is accepted, applies the type change,
  # and drops the nodePorts without a word - so these have to match
  # upstream's protocol and targetPort exactly.
  - patch: |-
      apiVersion: v1
      kind: Service
      metadata:
        name: argocd-server
      spec:
        type: NodePort
        ports:
          - name: http
            port: 80
            protocol: TCP
            targetPort: 8080
            nodePort: {{ argocd_server_nodeport_http }}
          - name: https
            port: 443
            protocol: TCP
            targetPort: 8080
            nodePort: {{ argocd_server_nodeport_https }}
{% endif %}
