# Managed by Ansible - roles/argocd/templates/root-application.yaml.j2
# Edits here are overwritten on the next run. Change the role instead.
#
# The app-of-apps root, and the only Application Ansible creates. Everything
# else Argo CD runs is declared under {{ argocd_repo_path }} in git and
# reached from here, so adding a workload is a commit rather than a playbook
# run.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ argocd_root_app_name }}
  namespace: {{ argocd_namespace }}
spec:
  project: default
  source:
    repoURL: {{ argocd_repo_url }}
    targetRevision: {{ argocd_repo_revision }}
    path: {{ argocd_repo_path }}
    directory:
      recurse: true
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argocd_namespace }}
  syncPolicy:
    automated:
      # Child Applications carry no deletion finalizer, so pruning one
      # removes the Application and leaves its workloads running rather than
      # taking them with it.
      prune: {{ 'true' if argocd_root_app_prune | bool else 'false' }}
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
