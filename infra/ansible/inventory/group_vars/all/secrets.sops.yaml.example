# Copy to secrets.sops.yaml, fill in, then encrypt:
#   sops --encrypt --in-place inventory/group_vars/all/secrets.sops.yaml
# The encrypted file is safe to commit. This example file is not - it holds
# no real values and exists only to document the expected keys.
---
tailscale_auth_key: tskey-auth-REPLACE-ME

# Shared by every k3s server - all three must use the same value,
# it cannot change without rebuilding the cluster
# openssl rand -hex 32
k3s_token: REPLACE-ME

# OAuth client for the Tailscale Kubernetes operator, which gives each
# published service its own name on the tailnet (ADR 0005). Create it at
# https://login.tailscale.com/admin/settings/oauth with the auth_keys write
# scope and the tag:k8s-operator tag. The secret is shown once.
tailscale_oauth_client_id: REPLACE-ME
tailscale_oauth_client_secret: tskey-client-REPLACE-ME
