# Copy to secrets.sops.yaml, fill in, then encrypt:
#   sops --encrypt --in-place inventory/group_vars/all/secrets.sops.yaml
# The encrypted file is safe to commit. This example file is not - it holds
# no real values and exists only to document the expected keys.
---
tailscale_auth_key: tskey-auth-REPLACE-ME

# Shared by every k3s server - all three must use the same value, and it
# cannot change without rebuilding the cluster. Generate one with:
#   openssl rand -hex 32
k3s_token: REPLACE-ME
